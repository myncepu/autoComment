{
  "name": "auto-comment-backend",
  "version": "1.0.0",
  "description": "Auto Comment Filler Backend API",
  "main": "server.js",
  "scripts": {
    "build:extension": "node scripts/build-extension-package.mjs",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:sync-worker": "npm --prefix cloudflare-sync test",
    "typecheck:sync-worker": "npm --prefix cloudflare-sync run typecheck",
    "verify:cloud-sync": "npm test && npm run test:sync-worker && npm run typecheck:sync-worker && npm --prefix cloudflare-sync run deploy:dry",
    "test:fixture": "node scripts/serve-extension-fixture.js",
    "test:chrome:console": "node scripts/run-batch-console-chrome-acceptance.mjs",
    "test:chrome:config-bundle": "node scripts/run-options-config-bundle-chrome-acceptance.mjs",
    "test:chrome:multi-assignment": "node scripts/run-multi-assignment-chrome-acceptance.mjs",
    "test:chrome:auto-submit-30": "node scripts/run-auto-submit-load-chrome-acceptance.mjs",
    "start": "node server.js",
    "dev": "node server.js",
    "csv:export": "node scripts/run-csv-export.js",
    "history:benchmark": "node scripts/benchmark-comment-history.mjs",
    "pm2:start": "pm2 start server.js --name auto-comment-api",
    "pm2:stop": "pm2 stop auto-comment-api",
    "pm2:restart": "pm2 restart auto-comment-api",
    "pm2:logs": "pm2 logs auto-comment-api"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mysql2": "^3.11.0",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
